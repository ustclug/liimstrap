#!/bin/bash

set -e

BASE="$(cd "$(dirname "$0")" && pwd)"
ROOT="$1"
LIIMSUSER="liims"
APT_SOURCE="${APT_SOURCE:-http://mirrors.ustc.edu.cn}"

if [ ! -d "$ROOT" ]; then
  exit 1
fi
ROOT="$(realpath "$ROOT")"
if [[ "$ROOT" = / || -e "$ROOT/etc/os-release" ]]; then
  echo "Use an empty rootfs directory, not an existing system." >&2
  exit 1
fi

# Track only mounts created by this build, including on failure.
mounts=()
cleanup() {
  local status=$? target
  trap - EXIT
  for ((i=${#mounts[@]}-1; i>=0; i--)); do
    target="${mounts[i]}"
    umount "$target" || status=1
  done
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
mount_root() {
  local target="${!#}"
  mount "$@"
  mounts+=("$target")
}

run() {
  chroot "$ROOT" "$@"
}

add_file() {
  while [ "$#" -ne 0 ]; do
    rsync -rlp "$BASE/$1" "$ROOT/$1"
    shift
  done
}

install_package() {
    DEBIAN_FRONTEND=noninteractive chroot "$ROOT" apt-get install --no-install-recommends --yes "$@"
}

check_sha256() {
    local file="$1"
    local sha256="$2"
    if [[ "$sha256" = $(sha256sum "$file" | cut -d ' ' -f 1) ]]; then
        return
    else
        echo "$file is corrupt."
        exit 1
    fi
}

# root password
if [ -n "$ROOT_PASSWORD" ]; then
  echo "Using root password from environment"
else
  ROOT_PASSWORD="$(head -c 6 /dev/urandom | base64)"
  echo "Root password not specified, using \"$ROOT_PASSWORD\""
fi

# External package: URL and hash must be changed together.
LIIMS_BROWSER_URL="${LIIMS_BROWSER_URL:-https://github.com/ustclug/liims-browser/releases/download/v0.1.0/liims-browser_0.1.0-1_amd64.deb}"
LIIMS_BROWSER_SHA256="${LIIMS_BROWSER_SHA256:-53ad64205589cad1abcea2498df711e937ffbd9f3bc22d4ecac4d9f55f540efb}"
GOST_URL="${GOST_URL:-https://github.com/go-gost/gost/releases/download/v3.3.0/gost_3.3.0_linux_amd64.tar.gz}"

# debootstrap
debootstrap --arch=amd64 trixie "$ROOT" "$APT_SOURCE/debian"
mount_root -t tmpfs none "$ROOT/dev"
chmod 755 "$ROOT/dev"
for device in null random urandom zero; do
  touch "$ROOT/dev/$device"
  mount_root --bind "/dev/$device" "$ROOT/dev/$device"
done
ln -s /proc/self/fd/0 "$ROOT/dev/stdin"
ln -s /proc/self/fd/1 "$ROOT/dev/stdout"
ln -s /proc/self/fd/2 "$ROOT/dev/stderr"
ln -s /proc/self/fd "$ROOT/dev/fd"
mkdir -p "$ROOT/dev/pts"
mount_root -t devpts -o newinstance,ptmxmode=0666 devpts "$ROOT/dev/pts"
ln -s pts/ptmx "$ROOT/dev/ptmx"
mount_root -t proc proc "$ROOT/proc"
mount_root -t tmpfs none "$ROOT/run"
mount_root -t sysfs sys "$ROOT/sys"
mount_root -t tmpfs none "$ROOT/tmp"

# Packages must not start daemons inside the build chroot.
printf '#!/bin/sh\nexit 101\n' > "$ROOT/usr/sbin/policy-rc.d"
chmod 755 "$ROOT/usr/sbin/policy-rc.d"

# apt update
add_file /etc/apt/sources.list
sed -Ei "s,https?://mirrors.ustc.edu.cn,$APT_SOURCE,g" "$ROOT/etc/apt/sources.list"
run apt-get update

# install packages
install_package labwc greetd waybar foot swayidle grim luit \
  libgl1-mesa-dri libegl-mesa0 dbus-user-session libpam-systemd \
  busybox dhcpcd-base dnsutils htop inetutils-ftp iputils-ping \
  inetutils-telnet iptables-persistent iproute2 iputils-arping iputils-clockdiff \
  initramfs-tools mtr-tiny ndisc6 nyancat \
  procps rsync sed ssh tar usbutils vim \
  adwaita-icon-theme librsvg2-common gnome-themes-extra \
  fonts-arphic-uming fonts-noto-cjk fonts-dejavu-core \
  fcitx5 fcitx5-frontend-gtk3 fcitx5-frontend-gtk4 fcitx5-chinese-addons \
  bash-completion curl ca-certificates jq systemd-timesyncd locales net-tools zstd

# We use standalone foot windows, not its globally enabled socket/server.
run systemctl --global disable foot-server.service foot-server.socket
run systemctl --global mask foot-server.service foot-server.socket

curl --fail --location --retry 3 --output "$ROOT/tmp/liims-browser.deb" "$LIIMS_BROWSER_URL"
check_sha256 "$ROOT/tmp/liims-browser.deb" "$LIIMS_BROWSER_SHA256"
install_package /tmp/liims-browser.deb
run liims-browser --check-config --profile default
run liims-browser --check-config --profile iat

# Transparent HTTP and TLS proxy from master.
curl --fail --location --retry 3 --output "$ROOT/tmp/gost.tar.gz" "$GOST_URL"
check_sha256 "$ROOT/tmp/gost.tar.gz" "676fb7f78d267b6ae73df719c0c7f2b565dde7147da935cfafbc1e1da558b6d5"
tar -xzf "$ROOT/tmp/gost.tar.gz" -C "$ROOT/usr/local/bin" gost
chmod 755 "$ROOT/usr/local/bin/gost"

# Assistant scripts
for script in "$BASE"/bin/*.sh; do
  install -Dm755 "$script" "$ROOT/usr/local/bin/$(basename "$script")"
done

# SSH login for root
add_file /etc/ssh/
printf "root:%s\n" "$ROOT_PASSWORD" | run chpasswd
run systemctl enable ssh

# time and NTP
TZ=Asia/Shanghai
echo "$TZ" > "$ROOT/etc/timezone"
run ln -sfn "/usr/share/zoneinfo/$TZ" /etc/localtime
add_file /etc/systemd/timesyncd.conf
run systemctl enable systemd-timesyncd.service

# locale
cp "$BASE/etc/locale.gen" "$ROOT/etc/locale.gen"
run locale-gen

# iptables
add_file /etc/iptables/
run systemctl enable netfilter-persistent.service
add_file /etc/gost/

# cron jobs
add_file /etc/systemd/system/
run systemctl enable liims-gost.service liims-reset.timer reboot.timer

# Wayland login
add_file /etc/greetd/
run systemctl enable greetd.service
run systemctl set-default graphical.target

# prevent systemd from changing network interface name
run ln -sf /dev/null /etc/udev/rules.d/80-net-setup-link.rules

# user specific
run userdel -fr "$LIIMSUSER" || true
run useradd -m -o -u 1000 -g users -s /bin/bash "$LIIMSUSER"
cp -r "$BASE/user/." "$ROOT/home/$LIIMSUSER"
run chown -R "$LIIMSUSER:" "/home/$LIIMSUSER"
cp "$BASE/user/.bashrc" "$ROOT/root/"

# Each graphical session owns its services; never keep them alive after logout.
rm -f "$ROOT/var/lib/systemd/linger/$LIIMSUSER"

# hostname & version
echo "liims" > "$ROOT/etc/hostname"
VERSION="$(date +%y%m%d)"
if [ -n "$GITHUB_RUN_NUMBER" ]; then
  VERSION="$VERSION-gh-$GITHUB_RUN_NUMBER"
fi
echo "$VERSION" > "$ROOT/etc/liims_version"

# kernel
install -Dm644 "$BASE/initramfs-tools/initramfs.conf" "$ROOT/etc/initramfs-tools/initramfs.conf"
install -Dm644 "$BASE/initramfs-tools/modules" "$ROOT/etc/initramfs-tools/modules"
install -Dm755 "$BASE/initramfs-tools/hooks/http-root" "$ROOT/etc/initramfs-tools/hooks/http-root"
install -Dm755 "$BASE/initramfs-tools/scripts/http" "$ROOT/etc/initramfs-tools/scripts/http"
install -Dm755 "$BASE/initramfs-tools/scripts/init-bottom/networkd.sh" "$ROOT/etc/initramfs-tools/scripts/init-bottom/networkd.sh"
install -Dm755 "$BASE/initramfs-tools/scripts/init-bottom/overlay.sh" "$ROOT/etc/initramfs-tools/scripts/init-bottom/overlay.sh"
install_package linux-image-amd64 linux-headers-amd64 firmware-linux firmware-realtek r8168-dkms

# Install systemd-resolved
install_package systemd-resolved
# Recover build chroot's DNS
cp --remove-destination /etc/resolv.conf "$ROOT/etc/resolv.conf"
# The initramfs uses dhcpcd for the boot lease. networkd takes over in the
# real system using the interface configuration written by networkd.sh.
run systemctl enable systemd-networkd.service systemd-resolved.service

# Remove unused locales
install_package localepurge
add_file /etc/locale.nopurge
run localepurge

# Remove unused docs
rm -rf "$ROOT/usr/share/doc/"*

# networking/miscellaneous
add_file /etc/hosts

# cleanup
run apt purge -y --autoremove ifupdown libfuse2 localepurge nano rsyslog tasksel
run apt-get clean

# Linking /etc/resolv.conf causing all DNS resolution fail in build container, make it after all operations requiring network
ln -sfn /run/systemd/resolve/stub-resolv.conf "$ROOT/etc/resolv.conf"

rm -rf "$ROOT/var"/{backups,tmp}/*
rm -rf "$ROOT"/*.old

rm -f "$ROOT/usr/sbin/policy-rc.d"
